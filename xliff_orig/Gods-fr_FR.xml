      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1625665045">
        <source>odin_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le Père de Toute Chose</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1268319559">
        <source>odin_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Si vous réussissez un pillage dans la province d'Odin, vous gagnez la récompense de pillage une nouvelle fois.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1877322225">
        <source>thor_name</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">THOR</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-806459546">
        <source>thor_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le Victorieux</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-124862498">
        <source>thor_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le vainqueur d'une bataille dans la province de Thor gagne 2 points de Gloire par figurine ennemie détruite.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1139907933">
        <source>tyr_name</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">TYR</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1168866564">
        <source>tyr_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le Seigneur de la Guerre</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="942687032">
        <source>tyr_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Dans la province de Tyr, la FOR de toutes les figurines équivaut à 0 (seule la FOR des Cartes de Bataille est prise en compte lors des batailles).</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1123327024">
        <source>frigga_name</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">FRIGGA</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1582593851">
        <source>frigga_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">La Mère Protectrice</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-49164331">
        <source>frigga_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Dans la province de Frigga, aucune figurine ne peut être détruite lors d'une bataille, quelle qu'en soit la raison.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-30785703">
        <source>loki_name</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">LOKI</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1192322890">
        <source>loki_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le Rusé</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1558252430">
        <source>loki_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Dans la province de Loki, les joueurs perdant la bataille gagnent la Gloire de la bataille à la place du gagnant.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1553126054">
        <source>heimdall_name</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">HEIMDALL</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-102611953">
        <source>heimdall_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le Vigilant</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="522993217">
        <source>heimdall_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Dans la province d'Heimdall, les Cartes de Bataille sont jouées face visible, une par une. Le joueur ayant lancé le pillage joue en dernier.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1616699401">
        <source>hel_name</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">HEL</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="950018086">
        <source>hel_title</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Celle qui est cachée</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="381460946">
        <source>hel_ability</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">L'invasion de la province d'Hel avec n'importe quelle figurine et par n'importe quel moyen ne coûte que 1 point de Rage (peu importent les autres modifications de coûts actives).</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2081941864">
        <source>ingame.moveGodHeadline</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Action de dieu</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1159956721">
        <source>ingame.moveGodOpponent</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le joueur qui a lancé le pillage déplace la figurine de dieu vers n'importe quelle province autorisée de son choix.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1634279378">
        <source>ingame.moveGodDescription</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Vous pouvez uniquement déplacer la figurine de dieu vers une province qui :
- ne contient pas d'autre dieu
- n'a pas été pillée
- n'a pas été détruite par le Ragnarök
S'il n'y a aucune province autorisée, le dieu ne se déplace pas.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-922584083">
        <source>ingame.invadeHelProvince</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">Envahir la province d'Hel coûte 1 point de Rage. Continuer ?</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-821269804">
        <source>ingame.godsBattleResult.godGlory</source>
        <target xml:lang="fr-FR" state="needs-translation">Gain de Gloire grâce à une capacité de dieu.</target>
      </trans-unit>
