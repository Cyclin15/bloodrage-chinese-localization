        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Cartas jugadas</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1726501219">
        <source>IngameInfo.PlayedcardsDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Aquí están las cartas de mejora que has jugado. Haz clic sobre una para obtener una vista detallada.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="750186238">
        <source>IngameInfo.Opponent</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Información del clan de tu oponente</target>
      </trans-unit>
