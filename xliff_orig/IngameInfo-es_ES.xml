        <source>IngameInfo.HornsDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Este es el indicador de Yelmos. Aquí verás cuántas figuras puedes tener a la vez sobre el tablero.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2062725342">
        <source>IngameInfo.Axes</source>
