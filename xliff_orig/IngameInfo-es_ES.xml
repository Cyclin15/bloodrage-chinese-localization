        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Este es el indicador de Hachas. Aquí verás cuánta Gloria recibes por las batallas que ganes.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1638717780">
        <source>IngameInfo.Glory</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Gloria</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1294616706">
        <source>IngameInfo.GloryDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Esta es tu Gloria. El jugador que tenga más gloria gana.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-619142440">
        <source>IngameInfo.AgePanel</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Panel de la Edad</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1613850322">
        <source>IngameInfo.AgePanelDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Aquí puedes encontrar las diferentes fases de cada Edad. También tienes un botón para "pasar" si quieres acabar ya tu turno.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1522335138">
        <source>IngameInfo.ValhallaPanel</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Panel del Valhalla</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-852533008">
        <source>IngameInfo.ValhallaPanelDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Aquí se muestran las figuras que esperan en el Valhalla.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-74338313">
        <source>IngameInfo.Playerframe</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Panel del jugador</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1384617431">
        <source>IngameInfo.PlayerframeDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">¡Este eres tú! Aquí encontrarás información importante sobre tu clan, como tu Ira actual, los tres medidores del clan y, si posas el ratón, podrás ver en qué posición se encuentran. Esto es importante porque un puesto alto en los medidores te otorgará Gloria extra al final de la partida.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="5135513">
        <source>IngameInfo.Handcards</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Cartas</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1402022069">
        <source>IngameInfo.HandcardsDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Estas son las cartas de tu mano. Las cartas señaladas son las que puedes jugar en cualquier situación.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-2078654699">
        <source>IngameInfo.Closeinfo</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Cerrar información</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1266294933">
