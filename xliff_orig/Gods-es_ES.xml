      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-306149280">
        <source>ingame.moveGod</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">Selecciona una nueva provincia para el dios.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1748910988">
        <source>odin_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">ODÍN</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1625665045">
        <source>odin_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El padre de todo</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1268319559">
        <source>odin_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">Si saqueas con éxito la provincia de Odín, recibes dos veces la recompensa del saqueo.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1877322225">
        <source>thor_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">THOR</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-806459546">
        <source>thor_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El victorioso</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-124862498">
        <source>thor_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El vencedor de una batalla librada en la provincia de Thor gana 2 de gloria por cada figura enemiga destruida.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1139907933">
        <source>tyr_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">TYR</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1168866564">
        <source>tyr_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El señor de la batalla</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="942687032">
        <source>tyr_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">En la provincia de Tyr, la fuerza de todas las figuras es 0 (es decir, que durante las batallas sólo se tendrá en cuenta la fuerza de las cartas de batalla).</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1123327024">
        <source>frigga_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">FRIGGA</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1582593851">
        <source>frigga_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">La madre protectora</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-49164331">
        <source>frigga_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">En la provincia de Frigga, ninguna figura se puede destruir por ningún motivo durante una batalla.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-30785703">
        <source>loki_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">LOKI</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1192322890">
        <source>loki_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El embaucador</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1558252430">
        <source>loki_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">En la provincia de Loki, serán los jugadores que pierdan una batalla quienes recibirán la gloria por la victoria y no el jugador vencedor.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1553126054">
        <source>heimdall_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">HEIMDALL</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-102611953">
        <source>heimdall_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El guardián vigilante</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="522993217">
        <source>heimdall_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">En la provincia de Heimdall, las cartas de batalla deben jugarse boca arriba de una en una; el jugador saqueador juega las suyas en último lugar.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1616699401">
        <source>hel_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">HEL</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="950018086">
        <source>hel_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">La deshonesta</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="381460946">
        <source>hel_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">Invadir la provincia de Hel con cualquier figura y de cualquier forma siempre cuesta 1 de Ira, independientemente del resto de modificaciones de coste.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2081941864">
        <source>ingame.moveGodHeadline</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">Acción divina</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1159956721">
        <source>ingame.moveGodOpponent</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">El jugador que saquea mueve la figura del dios a la provincia legal de su elección.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1634279378">
        <source>ingame.moveGodDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">Solo puedes mover la figura de un dios a una provincia que cumpla estos requisitos:
- No contener otro dios
- No haber sido saqueada
- No haber sido destruida por Ragnarök
Si no hay provincias legales, el dios no se moverá.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-922584083">
        <source>ingame.invadeHelProvince</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">Invadir la provincia de Hel cuesta 1 de Ira. ¿Quieres continuar?</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-821269804">
        <source>ingame.godsBattleResult.godGlory</source>
        <target xml:lang="es-ES" state="needs-translation">Ganancias de gloria de habilidad divina</target>
      </trans-unit>
