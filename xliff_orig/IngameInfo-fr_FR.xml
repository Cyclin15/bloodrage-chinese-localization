        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Cartes jouées</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1726501219">
        <source>IngameInfo.PlayedcardsDescription</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Les Cartes d'Amélioration que vous avez déjà jouées. Cliquez sur une carte pour en avoir un aperçu détaillé.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="750186238">
        <source>IngameInfo.Opponent</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="needs-translation">Infos de clan de votre adversaire</target>
      </trans-unit>
