    <body>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1299409002">
        <source>Emoji.NotBad</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Not bad!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="552771381">
        <source>Emoji.ThankYou</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Thank you!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2054865801">
        <source>Emoji.Oops</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Oops ...</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1997155309">
        <source>Emoji.WellPlayed</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Well played!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1466046835">
        <source>Emoji.Sorry</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Sorry!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="550768789">
        <source>Emoji.Wow</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Wow!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-741522159">
        <source>Emoji.ForOdin</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">For Odin!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1298023334">
        <source>Emoji.Hello</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Hello!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="167624954">
        <source>Emoji.Welcome</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Welcome!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="176388371">
        <source>Emoji.ItsAnHonourToMeetYou</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">It's an honour to meet you.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="590438147">
        <source>Emoji.YouWillDie</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">You will die!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="601349356">
        <source>Emoji.SeeYouInValhalla</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">See you in Valhalla!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-846021634">
        <source>Emoji.PrepareToDie</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Prepare to die!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="658880608">
        <source>Emoji.YouWillRegretThis</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">You will regret this!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="146928613">
        <source>Emoji.StandAndFight</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">It is better to stand and fight. If you run, you'll only die tired.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1065617211">
        <source>Emoji.SteppingForward</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">If you find your axe is too short, add to its length ... by stepping forward.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1959769705">
        <source>Emoji.OnlyForward</source>
        <target xml:lang="en-US">I demolish my bridges behind me - then there is no choice but forward!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="299484014">
        <source>Emoji.Childhood</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Few are bold in old age that are cowardly in childhood.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1164184345">
        <source>Emoji.SharpSword</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">When men meet foes in fight, better is stout heart than sharp sword.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-74977496">
        <source>Emoji.WolfTeeth</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Where Wolf's ears are, Wolf's teeth are near.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-509540075">
        <source>Emoji.FightFoes</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Fight you foes in the field, nor be burnt in your house.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-968909893">
        <source>Emoji.FearNoDeath</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Fear not death, for the hour of your doom is set and none may escape it.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="696690731">
        <source>Emoji.PrideKeepsPace</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">With many who come to power and honor, pride keeps pace with promotion.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1075689237">
        <source>Emoji.InTheSteath</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Even in the sheath, the sword must be sharp - so, too, must the mind and spirit be within the body.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1176262472">
        <source>Emoji.TheThrall</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">The thrall alone takes instant vengeance; the coward never.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="787128541">
        <source>Emoji.CowardsWaits</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Only a coward waits to be taken like a lamb from the fold or a fox from the trap.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2117698937">
        <source>Emoji.HoldTonque</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">No one is a total fool if he knows then to hold his tongue.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="234615884">
        <source>Emoji.InjusticeAndGreed</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Ill it is to abandon honor and integrity in exchange for injustice and greed.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="431052100">
        <source>Emoji.ReachingSky</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">There is more honor in accumulating little by little than reaching for the sky and ending up flat on your face.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-80265043">
        <source>Emoji.PersonsActions</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">A person's actions are often worse than their intentions.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="107757294">
        <source>Emoji.Stubbornness</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Stubbornness brings either great humiliation or great honor.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-145655665">
        <source>Emoji.GoWellAtFirst</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">It may go well at first, for those who try to lord it over others, but they may find things more difficult as time goes by.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="82494433">
        <source>Emoji.DeadWound</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">It often happens that he who gets a death wound yet avenges himself.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1462231988">
        <source>Emoji.Vengeance</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">The longer the vengeance is drawn out, the more satisfying it will be.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1399653875">
        <source>Emoji.HourOfAction</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Short is the hour for acting, and long the hour for feasting.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1511830301">
        <source>Emoji.BeFree</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Better it is to have a lower position in life and be free than to have a position of power only to be subject to the will of another.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-414964489">
        <source>Emoji.YellowSnow</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Don't eat the yellow snow!</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1121420341">
        <source>Emoji.Troll</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">One should warn even a dim-witted troll if he sits naked by a fire.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-393885946">
        <source>Emoji.LiveLong</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">It may often be that those live long who are slain with words alone.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-451785361">
        <source>Emoji.HungryWolf</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">A hungry wolf is bound to wage a hard battle.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1804013243">
        <source>Emoji.ShortKnife</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">He with a short knife must try, try again.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1454303211">
        <source>Emoji.Sailcloth</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Do not expect to make headway with a frail sailcloth.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1433565043">
        <source>Emoji.KingsPlace</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">The king’s palace is an easy place to enter but hard to leave.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="547798442">
        <source>Emoji.BadEnding</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">That which has a bad beginning, is likely to have a bad ending.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-243850631">
        <source>Emoji.Tyranny</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">All a people need in order to rise up against tyranny is a leader bold enough to take up the banner.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-2003721447">
        <source>Emoji.NewShirts</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Anybody who offends a more powerful man can hardly expect to wear out many more new shirts.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1054420617">
        <source>Emoji.WondedCoward</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">A wounded coward lies low.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1069484584">
        <source>Emoji.WolfChild</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Trust not him whose father, brother or other kin you have slain no matter how young he be, for often grows the wolf in the child.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-216051190">
        <source>Emoji.BurnedMan</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">The fire seems hottest to a burned man.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-297137929">
        <source>Emoji.Brotherless</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Bare is the back of a brotherless man.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-783106383">
        <source>Emoji.OldDog</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">One should listen when an old dog barks.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="824492753">
        <source>Emoji.Category.Greeting</source>
        <target xml:lang="en-US">Greet</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1553119209">
        <source>Emoji.Category.Threaten</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Threaten</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1692302246">
        <source>Emoji.Category.Proverb</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2">Proverb</target>
      </trans-unit>
    </body>
  </file>
