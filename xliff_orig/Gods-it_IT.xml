      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-306149280">
        <source>ingame.moveGod</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Seleziona una provincia per la divinità.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1748910988">
        <source>odin_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">ODINO</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1625665045">
        <source>odin_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Il padre del tutto</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1268319559">
        <source>odin_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Se effettui con successo un saccheggio nella provincia di Odino, ottieni di nuovo la ricompensa.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1877322225">
        <source>thor_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">THOR</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-806459546">
        <source>thor_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Il vittorioso</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-124862498">
        <source>thor_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Se vinci una battaglia nella provincia di Thor, ottieni 2 punti Gloria per ogni miniatura nemica distrutta.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1139907933">
        <source>tyr_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">TYR</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1168866564">
        <source>tyr_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Il signore della battaglia</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="942687032">
        <source>tyr_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">La FOR di tutte le miniature nella provincia di Tyr è pari a 0 (durante la battaglia calcola soltanto la FOR delle carte battaglia).</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1123327024">
        <source>frigga_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">FRIGGA</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1582593851">
        <source>frigga_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">La madre protettrice</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-49164331">
        <source>frigga_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Le miniature nella provincia di Frigga non possono essere distrutte per nessun motivo durante una battaglia.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-30785703">
        <source>loki_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">LOKI</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1192322890">
        <source>loki_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">L’ingannatore</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1558252430">
        <source>loki_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Se perdi una battaglia nella provincia di Loki, ottieni Gloria per la battaglia al posto del vincitore.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1553126054">
        <source>heimdall_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">HEIMDALL</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-102611953">
        <source>heimdall_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Il vigile guardiano</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="522993217">
        <source>heimdall_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Nella provincia di Heimdall le carte battaglia vanno giocate a faccia in su, una alla volta; chi effettua il Saccheggio gioca per ultimo.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1616699401">
        <source>hel_name</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">HEL</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="950018086">
        <source>hel_title</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">L'infida</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="381460946">
        <source>hel_ability</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Invadere la provincia di Hel, con ogni miniatura, costa sempre esattamente 1 Furia (a prescindere da ogni altra modifica di costo).</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2081941864">
        <source>ingame.moveGodHeadline</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Azione divina</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1159956721">
        <source>ingame.moveGodOpponent</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Il giocatore che effettua il saccheggio muove la miniatura della divinità in una provincia consentita a sua scelta.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1634279378">
        <source>ingame.moveGodDescription</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Puoi muovere la miniatura di una divinità solo in una provincia che:
- non contiene un'altra divinità
- non è stata ancora saccheggiata
- non è stata distrutta dal Ragnarök
Se non ci sono province in cui è consentito il movimento, la divinità non può essere mossa.</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-922584083">
        <source>ingame.invadeHelProvince</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">Invadere la provincia di Hel costa 1 punto Furia. Vuoi proseguire?</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-821269804">
        <source>ingame.godsBattleResult.godGlory</source>
        <target xml:lang="it-IT" state="needs-translation">Gloria ottenuta dall'abilità divina</target>
      </trans-unit>
