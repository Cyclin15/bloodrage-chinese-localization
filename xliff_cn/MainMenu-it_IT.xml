      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-125574836">
        <source>GameOptions.Expansions.BetaPannel</source>
        <target xml:lang="it-IT" xmlns="urn:oasis:names:tc:xliff:document:1.2">与诡计者、军阀、怪物猎手等各类 AI 原型一较高下！想和世界各地的玩家同场竞技吗？或者邀请好友共赴瓦尔哈拉之门？</target>
