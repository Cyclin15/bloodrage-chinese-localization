<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:jms="urn:jms:translation" version="1.2">
  <file source-language="en-US" target-language="es-ES" datatype="plaintext" original="not.available">
    <body>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-306149280">
        <source>ingame.moveGod</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">为该神明选择一个新的区域。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1748910988">
        <source>odin_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">奥丁</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1625665045">
        <source>odin_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">众神之父</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1268319559">
        <source>odin_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">如果你成功掠夺奥丁所在的区域，可再次获得该掠夺奖励。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1877322225">
        <source>thor_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">索尔</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-806459546">
        <source>thor_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">胜利者</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-124862498">
        <source>thor_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">在索尔所在的区域中，战斗的胜者每消灭一个敌方单位，便获得2点荣耀。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1139907933">
        <source>tyr_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">提尔</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1168866564">
        <source>tyr_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">战斗之主</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="942687032">
        <source>tyr_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">在提尔所在的区域中，所有单位的战力均视为0（战斗时只有战斗卡的战力会被计入）。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1123327024">
        <source>frigga_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">弗丽嘉</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1582593851">
        <source>frigga_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">守护之母</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-49164331">
        <source>frigga_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">在弗丽嘉所在的区域中，战斗期间任何单位都不会因任何原因被消灭。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-30785703">
        <source>loki_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">洛基</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1192322890">
        <source>loki_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">诡计之神</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1558252430">
        <source>loki_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">在洛基所在的区域中，战斗的败者们获得战斗荣耀，而非获胜的玩家。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1553126054">
        <source>heimdall_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">海姆达尔</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-102611953">
        <source>heimdall_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">守望卫士</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="522993217">
        <source>heimdall_ability</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">在海姆达尔所在的区域中，战斗卡须明置打出，每次一张，且由发起掠夺的玩家最后打出。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1616699401">
        <source>hel_name</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">赫尔</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="950018086">
        <source>hel_title</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">阴险者</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="381460946">
        <source>hel_ability</source>
        <target xml:lang="es-ES">以任何单位、任何方式入侵赫尔的区域，均恰好消耗1点怒气（无视任何其他费用修正）。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2081941864">
        <source>ingame.moveGodHeadline</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">神明行动</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1159956721">
        <source>ingame.moveGodOpponent</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">发起掠夺的玩家将该神明模型移动至其选择的任意合法区域。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1634279378">
        <source>ingame.moveGodDescription</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">你只能将神明模型移入满足以下条件的区域：
- 不包含其他神明
- 未被掠夺
- 未被诸神黄昏毁灭
若不存在合法区域，则该神明不移动。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-922584083">
        <source>ingame.invadeHelProvince</source>
        <target xml:lang="es-ES" xmlns="urn:oasis:names:tc:xliff:document:1.2">入侵赫尔的区域将消耗你1点怒气。是否继续？</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-821269804">
        <source>ingame.godsBattleResult.godGlory</source>
        <target xml:lang="es-ES">来自神明技能的荣耀收益</target>
      </trans-unit>
    </body>
  </file>
</xliff>