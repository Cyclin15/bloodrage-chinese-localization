        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">尼德霍格</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="914665025">
        <source>nidhoeggr_text</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">当你借此怪物赢得一场战斗后，败方每有一个位于瓦尔哈拉的单位，你便获得1点荣耀。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="864492040">
