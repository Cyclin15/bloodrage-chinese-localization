    <body>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-649132201">
        <source>fenrir_title</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">芬里尔</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1495487142">
        <source>fenrir_text</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">诸神黄昏将改为毁灭芬里尔所在的区域，而非原本注定毁灭的区域（若该区域为世界树则除外）。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-897056218">
        <source>garm_title</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">加尔姆</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1103844873">
        <source>garm_text</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">诸神黄昏将改为毁灭加尔姆所在的区域，而非原本注定毁灭的区域（若该区域为世界树则除外）。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-98426272">
        <source>hildisvini_title</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">希尔德斯维尼</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-2052923663">
        <source>hildisvini_text</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">当此怪物入侵某区域时，它可以替换该处的一个单位，并将该单位移至你选择的一个相邻区域。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-540360818">
        <source>mountain_giant_title</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">山岳巨人</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="998411103">
        <source>mountain_giant_text</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">此怪物视为首领。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-833234853">
        <source>mountain_giantess_title</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">山岳女巨人</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1245976010">
