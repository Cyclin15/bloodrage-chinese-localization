      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1114628294">
        <source>mystic_troll_title</source>
        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">神秘巨魔</target>
