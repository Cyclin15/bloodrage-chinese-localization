      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1484629843">
        <source>mystic_troll_text</source>
        <target xml:lang="en-US">你的单位免费入侵此怪物所在的区域。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1029880220">
