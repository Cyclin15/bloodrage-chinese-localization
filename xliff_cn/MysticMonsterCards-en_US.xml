        <target xml:lang="en-US" xmlns="urn:oasis:names:tc:xliff:document:1.2" state="translated">狼人</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1910450240">
        <source>wolfman_text</source>
        <target xml:lang="en-US">与此怪物战斗时，只有怪物的战力会被计入。</target>
      </trans-unit>
