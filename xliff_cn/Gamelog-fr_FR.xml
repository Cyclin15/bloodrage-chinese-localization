<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:jms="urn:jms:translation" version="1.2">
  <file source-language="en-US" target-language="fr-FR" datatype="plaintext" original="not.available">
    <body>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1486562811">
        <source>gamelog.actionphase</source>
        <target xml:lang="fr-FR">行动阶段开始。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1658551775">
        <source>gamelog.callToBattle</source>
        <target xml:lang="fr-FR">{0} 加入了{1}的战斗。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1351351488">
        <source>gamelog.discardCard</source>
        <target xml:lang="fr-FR">{0} 弃掉了{1}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1288453670">
        <source>gamelog.draw</source>
        <target xml:lang="fr-FR">{1}的战斗以平局告终。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1580820491">
        <source>gamelog.godsgift</source>
        <target xml:lang="fr-FR">诸神馈赠阶段开始。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1692720337">
        <source>gamelog.invade</source>
        <target xml:lang="fr-FR">{0} 派{2}入侵了{1}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1178164052">
        <source>gamelog.invadeFjord</source>
        <target xml:lang="fr-FR">{0} 派{2}入侵了峡湾。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-2027765327">
        <source>gamelog.move</source>
        <target xml:lang="fr-FR">{0} 将{1}从{2}行军至{3}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-400027066">
        <source>gamelog.pillage</source>
        <target xml:lang="fr-FR">{0} 在{1}发起了掠夺。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1691148268">
        <source>gamelog.playCard</source>
        <target xml:lang="fr-FR">{0} 打出了{1}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="237709076">
        <source>gamelog.playQuest</source>
        <target xml:lang="fr-FR">{0} 打出了一张任务卡。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="964821567">
        <source>gamelog.startplayer</source>
        <target xml:lang="fr-FR">{0} 是首位玩家。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="270982569">
        <source>gamelog.turn</source>
        <target xml:lang="fr-FR">轮到 {0} 行动。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-2012000310">
        <source>gamelog.win</source>
        <target xml:lang="fr-FR">{0} 赢得了{1}的战斗。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1342823063">
        <source>gamelog.discardPhase</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">弃牌阶段开始。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1160493479">
        <source>gamelog.questPhase</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">任务阶段开始。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1578314636">
        <source>gamelog.ragnarokPhase</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">诸神黄昏即将来临！</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-446995887">
        <source>gamelog.releaseValhallaPhase</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">单位从瓦尔哈拉返回。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="1631489745">
        <source>gamelog.repillage</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 在{1}再次发起了掠夺。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1770041338">
        <source>gamelog.callToBattlePass</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 拒绝了参战召唤。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-437250593">
        <source>gamelog.questFulfilled</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 完成了一项任务（{1}）。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="5101065">
        <source>gamelog.questFailed</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 未完成一项任务（{1}）。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="2116930362">
        <source>gamelog.ragnarokWillHit</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">诸神黄昏将降临{0}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-703542370">
        <source>gamelog.ragnarokHit</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">诸神黄昏摧毁了{0}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1965688651">
        <source>gamelog.discardCards</source>
        <target xml:lang="fr-FR">{0} 弃掉了{1}张卡。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-773842101">
        <source>gamelog.stealValues</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 通过{4}从{3}处获得了{1}点{2}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1118328820">
        <source>gamelog.gainedValues</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 通过{3}获得了{1}点{2}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-1426746804">
        <source>gamelog.gainedMultipleValues</source>
        <target xml:lang="fr-FR">{0} 通过{3}获得了{1}点怒气和{2}点荣耀。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-126037819">
        <source>gamelog.payForAbility</source>
        <target xml:lang="fr-FR">{0} 支付了{1}点怒气来使用{2}。</target>
      </trans-unit>
      <trans-unit xmlns="urn:oasis:names:tc:xliff:document:1.2" id="-881083918">
        <source>gamelog.discardAmount</source>
        <target xml:lang="fr-FR" xmlns="urn:oasis:names:tc:xliff:document:1.2">{0} 弃掉了{1}张卡。</target>
      </trans-unit>
    </body>
